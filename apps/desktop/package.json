{
  "name": "paper2run-desktop",
  "productName": "Paper2Run",
  "version": "0.1.0",
  "private": true,
  "description": "Paper2Run desktop app: local FastAPI backend + React UI in Electron",
  "author": "Paper2Run",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:mac": "python3 ../../scripts/desktop/build_desktop.py --target darwin-arm64",
    "dist:win": "python3 ../../scripts/desktop/build_desktop.py --target win32-x64"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "run.paper2run.desktop",
    "productName": "Paper2Run",
    "artifactName": "Paper2Run-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "main.cjs",
      "remote.cjs",
      "preload.cjs",
      "splash-preload.cjs",
      "splash.html",
      "splash.js",
      "package.json"
    ],
    "extraResources": [
      { "from": "../web/dist", "to": "web", "filter": ["**/*"] },
      { "from": "backend", "to": "backend", "filter": ["serve.py"] }
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extraResources": [
        { "from": ".runtime/darwin-${arch}/python", "to": "python", "filter": ["**/*"] },
        { "from": ".runtime/darwin-${arch}/node", "to": "node", "filter": ["**/*"] },
        { "from": ".runtime/darwin-${arch}/harness", "to": "harness", "filter": ["*.mjs", "package*.json"] },
        { "from": ".runtime/darwin-${arch}/harness/node_modules", "to": "harness/node_modules", "filter": ["**/*"] },
        { "from": ".runtime/darwin-${arch}/research-skills", "to": "research-skills", "filter": ["**/*"] },
        { "from": ".runtime/darwin-${arch}/harness-runtime.json", "to": "harness-runtime.json" }
      ]
    },
    "win": {
      "target": ["nsis", "zip"],
      "icon": "resources/icon.ico",
      "extraResources": [
        { "from": ".runtime/win32-${arch}/python", "to": "python", "filter": ["**/*"] },
        { "from": ".runtime/win32-${arch}/node", "to": "node", "filter": ["**/*"] },
        { "from": ".runtime/win32-${arch}/harness", "to": "harness", "filter": ["*.mjs", "package*.json"] },
        { "from": ".runtime/win32-${arch}/harness/node_modules", "to": "harness/node_modules", "filter": ["**/*"] },
        { "from": ".runtime/win32-${arch}/research-skills", "to": "research-skills", "filter": ["**/*"] },
        { "from": ".runtime/win32-${arch}/image", "to": "image", "filter": ["*.tar.gz"] },
        { "from": ".runtime/win32-${arch}/tunnel", "to": "tunnel", "filter": ["p2r-tunnel.exe", "remote.json", "relay-ca.pem"] },
        { "from": ".runtime/win32-${arch}/harness-runtime.json", "to": "harness-runtime.json" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "multiLanguageInstaller": true,
      "installerLanguages": ["zh_CN", "en_US"]
    }
  }
}
